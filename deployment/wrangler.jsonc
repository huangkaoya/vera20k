{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "werhd-vera-native",
  "main": "native-worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./generated/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [{"binding": "NATIVE_DATA", "bucket_name": "ra2res"}],
  "durable_objects": {"bindings": [{"name": "NATIVE_ROOMS", "class_name": "NativeRooms"}]},
  "migrations": [{"tag": "native-v2-1", "new_sqlite_classes": ["NativeRooms"]}],
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
