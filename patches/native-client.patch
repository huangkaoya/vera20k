+//! The native lobby is a presentation of server-admitted room configuration.
+use super::model::LobbySnapshot;
+use super::{Choice, Control, EditField, Label, Panel, RectPx};
+use serde_json::{Value, json};
+
+const COUNTRIES: [(&str, &str); 10] = [
+    ("America", "美国"),
+    ("Korea", "韩国"),
+    ("France", "法国"),
+    ("Germany", "德国"),
+    ("GreatBritain", "英国"),
+    ("Libya", "利比亚"),
+    ("Iraq", "伊拉克"),
+    ("Cuba", "古巴"),
+    ("Russia", "苏俄"),
+    ("Yuri", "尤里"),
+];
+const COLORS: [&str; 8] = [
+    "黄色", "红色", "蓝色", "绿色", "橙色", "青色", "紫色", "粉色",
+];
+
+fn player_choices(slot: i32, key: &str, values: Vec<(Value, String)>) -> Vec<Choice> {
+    values
+        .into_iter()
+        .map(|(value, label)| Choice {
+            label,
+            action: json!({"action":"updatePlayer","slot":slot,"player":{key:value}}),
+        })
+        .collect()
+}
+fn settings_choices(key: &str, values: &[(i32, &str)]) -> Vec<Choice> {
+    values
+        .iter()
+        .map(|(value, label)| Choice {
+            label: (*label).into(),
+            action: json!({"action":"updateSettings","settings":{key:value}}),
+        })
+        .collect()
+}
+fn number_label(value: i32, values: &[(i32, &str)]) -> String {
+    values
+        .iter()
+        .find(|(n, _)| *n == value)
+        .map_or_else(|| value.to_string(), |(_, label)| (*label).into())
+}
+
+pub(super) fn view(state: &LobbySnapshot, name: &str, code: &str) -> Panel {
+    let mut panel = Panel {
+        title: "联机作战大厅".into(),
+        subtitle: "王二火大 · 火线冲突 (2) · 与战友一起，再战一局".into(),
+        ..Default::default()
+    };
+    panel.controls.push(Control::button(
+        "lobby.close",
+        "返回主菜单",
+        RectPx::new(32, 550, 175, 32),
+        true,
+        json!({"action":"close"}),
+    ));
+    let busy = state.busy || state.starting || state.match_id.is_some();
+    if let Some(room) = state.room.as_ref() {
+        panel.labels.push(Label::new(
+            format!(
+                "房间 {}    {} / 2    {}",
+                room.code,
+                room.members.len(),
+                if room.is_host {
+                    "你是房主"
+                } else {
+                    "等待房主配置"
+                }
+            ),
+            RectPx::new(34, 94, 730, 23),
+        ));
+        for (label, x, w) in [
+            ("指挥官", 40, 170),
+            ("国家", 215, 135),
+            ("颜色", 360, 115),
+            ("出生点", 485, 115),
+            ("队伍", 610, 145),
+        ] {
+            panel
+                .labels
+                .push(Label::new(label, RectPx::new(x, 125, w, 21)));
+        }
+        let editable = room.is_host && !busy;
+        for (index, member) in room.members.iter().take(2).enumerate() {
+            let y = 151 + index as i32 * 58;
+            let player = room.config.players.iter().find(|p| p.slot == member.slot);
+            panel.labels.push(Label::new(
+                format!(
+                    "{}{}\n{}",
+                    member.name,
+                    if member.host { " · 房主" } else { "" },
+                    if member.ready {
+                        "已准备"
+                    } else {
+                        "未准备"
+                    }
+                ),
+                RectPx::new(40, y, 170, 46),
+            ));
+            let country = player.map_or("America", |p| p.country.as_str());
+            let country_label = COUNTRIES
+                .iter()
+                .find(|(id, _)| *id == country)
+                .map_or(country, |(_, label)| *label);
+            panel.controls.push(Control::select(
+                format!("lobby.player.{}.country", member.slot),
+                country_label,
+                RectPx::new(215, y, 135, 32),
+                editable,
+                player_choices(
+                    member.slot,
+                    "country",
+                    COUNTRIES
+                        .iter()
+                        .map(|(id, label)| (json!(id), (*label).into()))
+                        .collect(),
+                ),
+            ));
+            let color = player.map_or(member.slot, |p| p.color);
+            panel.controls.push(Control::select(
+                format!("lobby.player.{}.color", member.slot),
+                COLORS.get(color.max(0) as usize).copied().unwrap_or("随机"),
+                RectPx::new(360, y, 115, 32),
+                editable,
+                player_choices(
+                    member.slot,
+                    "color",
+                    COLORS
+                        .iter()
+                        .enumerate()
+                        .map(|(i, label)| (json!(i), (*label).into()))
+                        .collect(),
+                ),
+            ));
+            let start = player.map_or(member.slot, |p| p.start);
+            panel.controls.push(Control::select(
+                format!("lobby.player.{}.start", member.slot),
+                format!("{}", start + 1),
+                RectPx::new(485, y, 115, 32),
+                editable,
+                player_choices(
+                    member.slot,
+                    "start",
+                    vec![(json!(0), "1".into()), (json!(1), "2".into())],
+                ),
+            ));
+            let team = player.map_or(-1, |p| p.team);
+            panel.controls.push(Control::select(
+                format!("lobby.player.{}.team", member.slot),
+                number_label(team, &[(-1, "无"), (0, "A"), (1, "B"), (2, "C"), (3, "D")]),
+                RectPx::new(610, y, 145, 32),
+                editable,
+                player_choices(
+                    member.slot,
+                    "team",
+                    vec![
+                        (json!(-1), "无".into()),
+                        (json!(0), "A".into()),
+                        (json!(1), "B".into()),
+                        (json!(2), "C".into()),
+                        (json!(3), "D".into()),
+                    ],
+                ),
+            ));
+        }
+        if room.members.len() < 2 {
+            panel.labels.push(Label::new(
+                "等待另一位指挥官加入…",
+                RectPx::new(215, 212, 540, 30),
+            ));
+        }
+        let settings = &room.config.options;
+        for (key, label, value, x, choices) in [
+            (
+                "credits",
+                "初始资金",
+                settings.credits as i32,
+                40,
+                vec![
+                    (5000, "5,000"),
+                    (10000, "10,000"),
+                    (20000, "20,000"),
+                    (30000, "30,000"),
+                ],
+            ),
+            (
+                "unitCount",
+                "初始部队",
+                settings.unit_count as i32,
+                285,
+                vec![(0, "无"), (5, "5"), (10, "10")],
+            ),
+            (
+                "gameSpeed",
+                "游戏速度",
+                settings.game_speed as i32,
+                530,
+                vec![
+                    (0, "极速"),
+                    (1, "很快"),
+                    (2, "较快"),
+                    (3, "正常"),
+                    (4, "较慢"),
+                    (5, "慢速"),
+                    (6, "最慢"),
+                ],
+            ),
+        ] {
+            panel
+                .labels
+                .push(Label::new(label, RectPx::new(x, 269, 220, 22)));
+            panel.controls.push(Control::select(
+                format!("lobby.settings.{key}"),
+                number_label(value, &choices),
+                RectPx::new(x, 296, 220, 32),
+                editable,
+                settings_choices(key, &choices),
+            ));
+        }
+        for (index, (key, label, checked)) in [
+            ("shortGame", "快速游戏", settings.short_game),
+            ("superWeapons", "超级武器", settings.super_weapons),
+            ("crates", "随机工具箱", settings.crates),
+            ("mcvRepacks", "基地重新部署", settings.mcv_repacks),
+            ("buildOffAlly", "盟友旁建造", settings.build_off_ally),
+            (
+                "destroyableBridges",
+                "可摧毁桥梁",
+                settings.destroyable_bridges,
+            ),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let x = 40 + (index % 2) as i32 * 370;
+            let y = 346 + (index / 2) as i32 * 34;
+            panel.controls.push(Control::check(
+                format!("lobby.settings.{key}"),
+                label,
+                RectPx::new(x, y, 350, 29),
+                editable,
+                checked,
+                json!({"action":"updateSettings","settings":{key:!checked}}),
+            ));
+        }
+        panel.controls.push(Control::button(
+            "lobby.leave",
+            "离开房间",
+            RectPx::new(233, 550, 175, 32),
+            !state.busy,
+            json!({"action":"leave"}),
+        ));
+        if room.is_host {
+            panel.controls.push(Control::button(
+                "lobby.start",
+                "开始作战",
+                RectPx::new(548, 550, 220, 32),
+                room.can_start && !busy,
+                json!({"action":"start"}),
+            ));
+        } else {
+            let ready = room
+                .members
+                .iter()
+                .find(|m| m.id == room.local_member_id)
+                .is_some_and(|m| m.ready);
+            panel.controls.push(Control::button(
+                "lobby.ready",
+                if ready {
+                    "取消准备"
+                } else {
+                    "准备就绪"
+                },
+                RectPx::new(548, 550, 220, 32),
+                !busy,
+                json!({"action":"ready"}),
+            ));
+        }
+    } else if state.stopped || state.phase == "stopped" {
+        panel
+            .labels
+            .push(Label::new("对局已停止", RectPx::new(70, 150, 660, 32)));
+        panel.labels.push(Label::new(
+            "请返回主菜单，再开始下一场作战。",
+            RectPx::new(70, 204, 660, 50),
+        ));
+    } else {
+        panel
+            .labels
+            .push(Label::new("指挥官名称", RectPx::new(60, 114, 170, 28)));
+        panel.controls.push(Control::edit(
+            "lobby.name",
+            name,
+            RectPx::new(245, 110, 490, 34),
+            !busy,
+            EditField::Name,
+        ));
+        panel
+            .labels
+            .push(Label::new("建立作战房间", RectPx::new(62, 192, 305, 27)));
+        panel.labels.push(Label::new(
+            "创建后，将房间代码告诉另一位指挥官。",
+            RectPx::new(62, 236, 305, 64),
+        ));
+        panel.controls.push(Control::button(
+            "lobby.create",
+            "创建房间",
+            RectPx::new(62, 324, 305, 36),
+            !busy,
+            json!({"action":"create","name":name}),
+        ));
+        panel
+            .labels
+            .push(Label::new("加入战友", RectPx::new(430, 192, 305, 27)));
+        panel
+            .labels
+            .push(Label::new("房间代码", RectPx::new(430, 236, 305, 25)));
+        panel.controls.push(Control::edit(
+            "lobby.code",
+            code,
+            RectPx::new(430, 270, 305, 34),
+            !busy,
+            EditField::Code,
+        ));
+        panel.controls.push(Control::button(
+            "lobby.join",
+            "加入房间",
+            RectPx::new(430, 324, 305, 36),
+            !busy && !code.trim().is_empty(),
+            json!({"action":"join","code":code,"name":name}),
+        ));
+        panel.labels.push(Label::new(
+            "选定国家、颜色、出生点和队伍，双方准备后由房主开战。",
+            RectPx::new(62, 399, 673, 45),
+        ));
+    }
+    let status = if !state.error.is_empty() {
+        &state.error
+    } else if !state.status.is_empty() {
+        &state.status
+    } else if state.starting {
+        "双方正在载入原生战场…"
+    } else if state.busy {
+        "正在联络…"
+    } else if state.connected {
+        "联机服务已连接"
+    } else {
+        "创建或加入房间后连接联机服务"
+    };
+    let mut label = Label::new(status, RectPx::new(40, 466, 714, 62));
+    if !state.error.is_empty() {
+        label.rgb = [1.0, 0.38, 0.28];
+    }
+    panel.labels.push(label);
+    panel
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn entry_join_requires_a_code_and_forwards_native_edit_values() {
+        let panel = view(&LobbySnapshot::default(), "指挥官", "ABC123");
+        let join = panel
+            .controls
+            .iter()
+            .find(|c| c.id == "lobby.join")
+            .unwrap();
+        assert!(join.enabled);
+        assert_eq!(join.action["code"], "ABC123");
+        assert_eq!(join.action["name"], "指挥官");
+        let empty = view(&LobbySnapshot::default(), "指挥官", "");
+        assert!(
+            !empty
+                .controls
+                .iter()
+                .find(|c| c.id == "lobby.join")
+                .unwrap()
+                .enabled
+        );
+    }
+    #[test]
+    fn guests_cannot_edit_host_settings_or_start() {
+        let state:LobbySnapshot=serde_json::from_value(json!({"room":{"isHost":false,"members":[{"id":"guest","slot":1}],"config":{"players":[{"slot":1,"country":"Yuri"}],"options":{}}}})).unwrap();
+        let panel = view(&state, "", "");
+        assert!(panel.controls.iter().filter(|c|c.id.starts_with("lobby.settings.")||c.id.starts_with("lobby.player.")).all(|c|!c.enabled));
+        assert!(panel.controls.iter().any(|c| c.id == "lobby.ready"));
+        assert!(!panel.controls.iter().any(|c| c.id == "lobby.start"));
+    }
+    #[test]
+    fn host_readiness_and_busy_gate_start() {
+        for (can_start, busy, enabled) in [
+            (true, false, true),
+            (false, false, false),
+            (true, true, false),
+        ] {
+            let state: LobbySnapshot = serde_json::from_value(
+                json!({"busy":busy,"room":{"isHost":true,"canStart":can_start,"members":[]}}),
+            )
+            .unwrap();
+            assert_eq!(
+                view(&state, "", "")
+                    .controls
+                    .iter()
+                    .find(|c| c.id == "lobby.start")
+                    .unwrap()
+                    .enabled,
+                enabled
+            );
+        }
+    }
+}
diff --git a/src/app/browser_shell/model.rs b/src/app/browser_shell/model.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bd96cb95dd263a4da169e1f6a967b7773684abf9
--- /dev/null
+++ b/src/app/browser_shell/model.rs
@@ -0,0 +1,205 @@
+//! Presentation receipts from the browser content and lobby owners.
+//!
+//! These DTOs never author downloads, rooms, or simulation state. Missing
+//! presentation fields retain defaults so older browser hosts remain readable.
+
+use serde::Deserialize;
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct ContentSnapshot {
+    pub profile: String,
+    pub addons: Vec<String>,
+    pub profiles: Vec<ContentItem>,
+    pub packs: Vec<ContentItem>,
+    pub selection: ContentSelection,
+    pub job: Option<ContentJob>,
+    pub message: String,
+    pub error: bool,
+    pub downloading: bool,
+    pub activating: bool,
+    pub activation_allowed: bool,
+    pub can_activate: bool,
+    pub open: bool,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct ContentItem {
+    pub id: String,
+    pub title: String,
+    pub description: String,
+    pub bytes: u64,
+    pub raw_bytes: u64,
+    pub cached: String,
+    pub included: bool,
+    pub checked: bool,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct ContentSelection {
+    pub bytes: u64,
+    pub raw_bytes: u64,
+    pub files: u32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct ContentJob {
+    pub title: String,
+    pub file: String,
+    pub completed_files: u32,
+    pub total_files: u32,
+    pub wire_bytes: u64,
+    pub wire_total_bytes: u64,
+    pub total_wire_bytes: u64,
+    pub transferred_wire_bytes: u64,
+    pub stage: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct LobbySnapshot {
+    pub schema: u32,
+    pub open: bool,
+    pub name: String,
+    pub code: String,
+    pub connected: bool,
+    pub busy: bool,
+    pub status: String,
+    pub error: String,
+    pub match_id: Option<String>,
+    pub starting: bool,
+    pub stopped: bool,
+    pub native_started: bool,
+    pub phase: String,
+    pub room: Option<LobbyRoom>,
+}
+
+impl Default for LobbySnapshot {
+    fn default() -> Self {
+        Self {
+            schema: 1,
+            open: false,
+            name: String::new(),
+            code: String::new(),
+            connected: false,
+            busy: false,
+            status: String::new(),
+            error: String::new(),
+            match_id: None,
+            starting: false,
+            stopped: false,
+            native_started: false,
+            phase: "entry".to_owned(),
+            room: None,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct LobbyRoom {
+    pub code: String,
+    pub is_host: bool,
+    pub local_member_id: String,
+    pub members: Vec<LobbyMember>,
+    pub can_start: bool,
+    pub phase: String,
+    pub config: LobbyConfig,
+    pub status: String,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct LobbyMember {
+    pub id: String,
+    pub name: String,
+    pub ready: bool,
+    pub host: bool,
+    pub slot: i32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct LobbyConfig {
+    pub map: String,
+    pub seed: u32,
+    pub players: Vec<LobbyPlayer>,
+    pub options: LobbyOptions,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct LobbyPlayer {
+    pub slot: i32,
+    pub name: String,
+    pub country: String,
+    pub color: i32,
+    pub start: i32,
+    pub team: i32,
+    pub human: bool,
+    pub difficulty: String,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub(crate) struct LobbyOptions {
+    pub credits: u32,
+    pub unit_count: u32,
+    pub game_speed: u32,
+    pub short_game: bool,
+    pub super_weapons: bool,
+    pub crates: bool,
+    pub mcv_repacks: bool,
+    pub build_off_ally: bool,
+    pub destroyable_bridges: bool,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn partial_content_receipts_keep_safe_disabled_defaults() {
+        let snapshot: ContentSnapshot = serde_json::from_str(
+            r#"{"profile":"skirmish","profiles":[{"id":"skirmish","cached":"已校验缓存"}],"selection":{"files":26,"rawBytes":602239457},"job":{"wireTotalBytes":4110830,"stage":"verify"}}"#,
+        )
+        .unwrap();
+        assert_eq!(snapshot.selection.files, 26);
+        assert_eq!(snapshot.selection.raw_bytes, 602239457);
+        assert_eq!(snapshot.profiles[0].cached, "已校验缓存");
+        assert_eq!(snapshot.job.unwrap().wire_total_bytes, 4110830);
+        assert!(!snapshot.can_activate);
+        assert!(!snapshot.activation_allowed);
+        assert!(!snapshot.error);
+        assert!(snapshot.packs.is_empty());
+    }
+
+    #[test]
+    fn lobby_receipts_preserve_signed_player_settings_and_maximum_seed() {
+        let snapshot: LobbySnapshot = serde_json::from_str(
+            r#"{"open":true,"matchId":null,"phase":"room","room":{"code":"ABCDEF","isHost":true,"localMemberId":"host-id","members":[{"id":"host-id","slot":0,"host":true,"ready":true}],"config":{"seed":4294967295,"players":[{"slot":0,"country":"Yuri","start":-1,"team":-1}],"options":{"unitCount":10,"mcvRepacks":true,"buildOffAlly":false}}}}"#,
+        )
+        .unwrap();
+        assert_eq!(snapshot.schema, 1);
+        assert_eq!(snapshot.phase, "room");
+        assert!(snapshot.match_id.is_none());
+        let room = snapshot.room.unwrap();
+        assert!(room.is_host);
+        assert_eq!(room.local_member_id, "host-id");
+        assert_eq!(room.config.seed, u32::MAX);
+        assert_eq!(room.config.players[0].start, -1);
+        assert_eq!(room.config.players[0].team, -1);
+        assert!(room.config.options.mcv_repacks);
+        assert!(
+            !room.can_start,
+            "absent readiness never enables the start button"
+        );
+        let initial: LobbySnapshot = serde_json::from_str("{}").unwrap();
+        assert_eq!(initial.phase, "entry");
+        assert!(!initial.busy);
+        assert!(initial.room.is_none());
+    }
+}
diff --git a/src/app/browser_shell/text_input.rs b/src/app/browser_shell/text_input.rs
new file mode 100644
index 0000000000000000000000000000000000000000..89061b3a25b912151ac1a1813a6c49ce9d064fb8
--- /dev/null
+++ b/src/app/browser_shell/text_input.rs
@@ -0,0 +1,341 @@
+//! Invisible browser text-service adapter. Rust retains the visible draft,
+//! selection, layout, and command authority; the DOM holds only an IME's
+//! transient composition and never a copy of the native edit value.
+
+#[derive(Debug)]
+pub(super) struct InputEvent {
+    pub field: String,
+    pub generation: u64,
+    pub kind: InputKind,
+}
+
+#[derive(Debug)]
+pub(super) enum InputKind {
+    Commit(String),
+    Preedit(String),
+    Key {
+        key: String,
+        ctrl: bool,
+        meta: bool,
+        shift: bool,
+    },
+    Paste(String),
+}
+
+#[cfg(target_arch = "wasm32")]
+mod browser {
+    use super::{InputEvent, InputKind};
+    use std::cell::{Cell, RefCell};
+    use std::rc::Rc;
+    use wasm_bindgen::{JsCast, JsValue, closure::Closure};
+    use web_sys::{Event, HtmlElement};
+
+    thread_local! {
+        static BRIDGE: RefCell<Option<Bridge>> = const { RefCell::new(None) };
+        static EVENTS: RefCell<Vec<InputEvent>> = const { RefCell::new(Vec::new()) };
+        static FOCUS_TRANSFER: Cell<bool> = const { Cell::new(false) };
+    }
+    struct Session {
+        field: String,
+        generation: u64,
+        composing: Cell<bool>,
+        echo: RefCell<Option<String>>,
+    }
+    struct Bridge {
+        input: HtmlElement,
+        session: Rc<Session>,
+        listeners: Vec<(&'static str, Closure<dyn FnMut(Event)>)>,
+    }
+    fn property(value: &JsValue, key: &str) -> JsValue {
+        js_sys::Reflect::get(value, &key.into()).unwrap_or(JsValue::UNDEFINED)
+    }
+    fn text(value: &JsValue, key: &str) -> String {
+        property(value, key).as_string().unwrap_or_default()
+    }
+    fn clear(input: &HtmlElement) {
+        let _ = js_sys::Reflect::set(input, &"value".into(), &"".into());
+    }
+    fn bounded(value: String) -> String {
+        value.chars().take(4096).collect()
+    }
+    fn enqueue(session: &Session, kind: InputKind) {
+        EVENTS.with(|events| {
+            let mut events = events.borrow_mut();
+            if events.len() < 256 {
+                events.push(InputEvent {
+                    field: session.field.clone(),
+                    generation: session.generation,
+                    kind,
+                });
+            }
+        });
+        crate::app::browser::wake();
+    }
+    fn key(session: &Session, value: String, event: &Event) {
+        enqueue(
+            session,
+            InputKind::Key {
+                key: bounded(value),
+                ctrl: property(event, "ctrlKey").as_bool().unwrap_or(false),
+                meta: property(event, "metaKey").as_bool().unwrap_or(false),
+                shift: property(event, "shiftKey").as_bool().unwrap_or(false),
+            },
+        );
+    }
+    fn focused(input: &HtmlElement) -> bool {
+        web_sys::window()
+            .and_then(|window| window.document())
+            .and_then(|document| document.active_element())
+            .is_some_and(|element| element == input.clone().unchecked_into::<web_sys::Element>())
+    }
+    fn focus_element(input: &HtmlElement) {
+        if let Ok(method) = property(input, "focus").dyn_into::<js_sys::Function>() {
+            let options = js_sys::Object::new();
+            let _ = js_sys::Reflect::set(&options, &"preventScroll".into(), &JsValue::TRUE);
+            let _ = method.call1(input, &options);
+        }
+    }
+    impl Bridge {
+        fn new(field: &str, generation: u64) -> Result<Self, JsValue> {
+            let document = web_sys::window()
+                .and_then(|window| window.document())
+                .ok_or_else(|| JsValue::from_str("Document is unavailable"))?;
+            let input: HtmlElement = document.create_element("textarea")?.dyn_into()?;
+            for (name, value) in [
+                ("tabindex", "-1"),
+                ("aria-hidden", "true"),
+                ("autocomplete", "off"),
+                ("autocapitalize", "off"),
+                ("spellcheck", "false"),
+                (
+                    "style",
+                    "position:fixed;left:-10000px;top:0;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden;font-size:16px;",
+                ),
+            ] {
+                input.set_attribute(name, value)?;
+            }
+            document
+                .body()
+                .ok_or_else(|| JsValue::from_str("Document body is unavailable"))?
+                .append_child(&input)?;
+            let mut bridge = Self {
+                input,
+                session: Rc::new(Session {
+                    field: field.to_owned(),
+                    generation,
+                    composing: Cell::new(false),
+                    echo: RefCell::new(None),
+                }),
+                listeners: Vec::new(),
+            };
+            for kind in [
+                "keydown",
+                "keyup",
+                "compositionstart",
+                "compositionupdate",
+                "compositionend",
+                "beforeinput",
+                "input",
+                "paste",
+            ] {
+                let input = bridge.input.clone();
+                let session = Rc::clone(&bridge.session);
+                let listener = Closure::wrap(Box::new(move |event: Event| {
+                    event.stop_propagation();
+                    match kind {
+                        "keydown" => {
+                            let value = text(&event, "key");
+                            if session.composing.get()
+                                || property(&event, "isComposing").as_bool() == Some(true)
+                                || value == "Process"
+                                || property(&event, "keyCode").as_f64() == Some(229.0)
+                            {
+                                return;
+                            }
+                            session.echo.borrow_mut().take();
+                            // A trusted paste must retain its browser default so
+                            // clipboardData is delivered to the paste listener.
+                            let paste = value.eq_ignore_ascii_case("v")
+                                && (property(&event, "ctrlKey").as_bool() == Some(true)
+                                    || property(&event, "metaKey").as_bool() == Some(true));
+                            if !paste {
+                                event.prevent_default();
+                            }
+                            key(&session, value, &event);
+                        }
+                        "compositionstart" => {
+                            session.composing.set(true);
+                            session.echo.borrow_mut().take();
+                        }
+                        "compositionupdate" => {
+                            enqueue(&session, InputKind::Preedit(bounded(text(&event, "data"))))
+                        }
+                        "compositionend" => {
+                            session.composing.set(false);
+                            let mut value = text(&event, "data");
+                            if value.is_empty() {
+                                value = text(&input, "value");
+                            }
+                            value = bounded(value);
+                            *session.echo.borrow_mut() = Some(value.clone());
+                            enqueue(&session, InputKind::Commit(value));
+                            clear(&input);
+                            // Keep the receipt until final input consumes it.
+                            // A microtask can run before that event and would
+                            // make the same composition commit twice. The next
+                            // key/composition/paste also resets this receipt.
+                        }
+                        "beforeinput" if !session.composing.get() => {
+                            let kind = text(&event, "inputType");
+                            if kind.starts_with("delete") {
+                                event.prevent_default();
+                                clear(&input);
+                                key(
+                                    &session,
+                                    if kind.ends_with("Forward") {
+                                        "Delete"
+                                    } else {
+                                        "Backspace"
+                                    }
+                                    .into(),
+                                    &event,
+                                );
+                            }
+                        }
+                        "input"
+                            if !session.composing.get()
+                                && property(&event, "isComposing").as_bool() != Some(true) =>
+                        {
+                            let mut value = text(&input, "value");
+                            if value.is_empty() {
+                                value = text(&event, "data");
+                            }
+                            value = bounded(value);
+                            let echo = session.echo.borrow_mut().take();
+                            if !value.is_empty() && echo.as_deref() != Some(value.as_str()) {
+                                enqueue(&session, InputKind::Commit(value));
+                            }
+                            clear(&input);
+                        }
+                        "paste" => {
+                            event.prevent_default();
+                            session.echo.borrow_mut().take();
+                            let clipboard = property(&event, "clipboardData");
+                            if let Ok(get) =
+                                property(&clipboard, "getData").dyn_into::<js_sys::Function>()
+                            {
+                                if let Ok(value) = get.call1(&clipboard, &"text/plain".into()) {
+                                    if let Some(value) = value.as_string() {
+                                        enqueue(&session, InputKind::Paste(bounded(value)));
+                                    }
+                                }
+                            }
+                            clear(&input);
+                        }
+                        _ => {}
+                    }
+                }) as Box<dyn FnMut(Event)>);
+                bridge
+                    .input
+                    .add_event_listener_with_callback(kind, listener.as_ref().unchecked_ref())?;
+                bridge.listeners.push((kind, listener));
+            }
+            Ok(bridge)
+        }
+    }
+    impl Drop for Bridge {
+        fn drop(&mut self) {
+            for (kind, listener) in &self.listeners {
+                let _ = self
+                    .input
+                    .remove_event_listener_with_callback(kind, listener.as_ref().unchecked_ref());
+            }
+            clear(&self.input);
+            self.input.remove();
+        }
+    }
+    pub(crate) fn focus(field: &str, generation: u64) {
+        if BRIDGE.with(|bridge| {
+            bridge.borrow().as_ref().is_some_and(|bridge| {
+                bridge.session.field == field && bridge.session.generation == generation
+            })
+        }) {
+            return;
+        }
+        drop(BRIDGE.with(|bridge| bridge.borrow_mut().take()));
+        match Bridge::new(field, generation) {
+            Ok(bridge) => {
+                let input = bridge.input.clone();
+                BRIDGE.with(|slot| *slot.borrow_mut() = Some(bridge));
+                // No RefCell borrow may survive focus(): its synchronous focus
+                // edge can reenter the native WindowActive consumer.
+                FOCUS_TRANSFER.with(|transfer| transfer.set(true));
+                focus_element(&input);
+                FOCUS_TRANSFER.with(|transfer| transfer.set(false));
+            }
+            Err(_) => log::warn!("Browser text service is unavailable"),
+        }
+    }
+    pub(crate) fn blur() {
+        let bridge = BRIDGE.with(|bridge| bridge.borrow_mut().take());
+        let restore =
+            bridge.as_ref().is_some_and(|bridge| focused(&bridge.input)) && document_focused();
+        drop(bridge);
+        if restore {
+            if let Some(canvas) = web_sys::window()
+                .and_then(|window| window.document())
+                .and_then(|document| document.get_element_by_id("game"))
+                .and_then(|element| element.dyn_into::<HtmlElement>().ok())
+            {
+                focus_element(&canvas);
+            }
+        }
+    }
+    pub(crate) fn active() -> bool {
+        // Chromium may temporarily expose body as activeElement during the
+        // canvas blur dispatched *inside* input.focus(). Only this synchronous
+        // owned transfer counts; a later real browser/OS blur never does.
+        BRIDGE.with(|bridge| {
+            bridge
+                .borrow()
+                .as_ref()
+                .is_some_and(|bridge| focused(&bridge.input) || FOCUS_TRANSFER.with(Cell::get))
+        })
+    }
+    pub(crate) fn document_focused() -> bool {
+        web_sys::window()
+            .and_then(|window| window.document())
+            .is_some_and(|document| {
+                !document.hidden()
+                    && property(&document, "hasFocus")
+                        .dyn_into::<js_sys::Function>()
+                        .ok()
+                        .and_then(|method| method.call0(&document).ok())
+                        .and_then(|value| value.as_bool())
+                        .unwrap_or(false)
+            })
+    }
+    pub(crate) fn drain() -> Vec<InputEvent> {
+        EVENTS.with(|events| std::mem::take(&mut *events.borrow_mut()))
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(super) use browser::{active, blur, document_focused, drain, focus};
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn focus(_field: &str, _generation: u64) {}
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn blur() {}
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn active() -> bool {
+    false
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn document_focused() -> bool {
+    false
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn drain() -> Vec<InputEvent> {
+    Vec::new()
+}
