+    /// Run one synchronous app input producer through its ordinary native
+    /// admission/codec owner, then transfer only the records it appended to
+    /// the caller. Existing queued world-generated work stays in this queue.
+    /// A browser network transport uses this seam before any world advance;
+    /// only the server's ordered echo is subsequently admitted as gameplay.
+    pub fn capture_queued_commands<R>(
+        &mut self,
+        producer: impl FnOnce(&mut Self) -> R,
+    ) -> (R, Vec<CommandEnvelope>) {
+        let previous = self.pending_commands.len();
+        let result = producer(self);
+        let captured = self.pending_commands.split_off(previous);
+        (result, captured)
+    }
