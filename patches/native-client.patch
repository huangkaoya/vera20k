diff --git a/src/app/browser.rs b/src/app/browser.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9cd989a669c755192fc266ac5854c14524930922
--- /dev/null
+++ b/src/app/browser.rs
@@ -0,0 +1,485 @@
+//! Browser lifecycle for the ordinary native App, menus and tactical input.
+//!
+//! Resource hydration is completed by web_entry before this module starts.
+//! The browser owns its event loop; no executor blocks JavaScript while wgpu
+//! requests its adapter/device. AppState and every gameplay owner remain native.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+use std::sync::Arc;
+
+use serde_json::{Value, json};
+use wasm_bindgen::JsValue;
+use web_sys::HtmlCanvasElement;
+use web_time::Instant;
+use winit::event::{ElementState, TouchPhase, WindowEvent};
+use winit::event_loop::{ActiveEventLoop, EventLoop, EventLoopProxy};
+use winit::platform::web::EventLoopExtWebSys;
+use winit::window::Window;
+
+use super::{App, AppState, GameScreen, GpuContext};
+
+mod network_launch;
+
+thread_local! {
+    static STARTED: Cell<bool> = const { Cell::new(false) };
+    static DIAGNOSTICS_ENABLED: Cell<bool> = const { Cell::new(false) };
+    static DIAGNOSTICS: RefCell<Value> = RefCell::new(json!({"stage":"not-started"}));
+    static NETWORK_START: RefCell<Option<network_launch::NetworkStartConfig>> = const { RefCell::new(None) };
+    static NETWORK_LEAVE: RefCell<Option<String>> = const { RefCell::new(None) };
+    static BROWSER_PROXY: RefCell<Option<EventLoopProxy<()>>> = const { RefCell::new(None) };
+}
+
+/// Wake the ordinary winit app pass from transport callbacks, including when
+/// requestAnimationFrame is suspended in a hidden browser tab.
+pub fn wake() {
+    BROWSER_PROXY.with(|proxy| {
+        if let Some(proxy) = proxy.borrow().as_ref() {
+            let _ = proxy.send_event(());
+        }
+    });
+}
+
+pub fn leave_network_match(match_id: &str) -> Result<(), JsValue> {
+    let pending = NETWORK_START.with(|pending| {
+        pending
+            .borrow()
+            .as_ref()
+            .is_some_and(|config| config.match_id == match_id)
+    });
+    let current = crate::app::browser_network::status()["matchId"].as_str() == Some(match_id);
+    if !pending && !current {
+        return Err(JsValue::from_str("该网络对局已经结束"));
+    }
+    NETWORK_LEAVE.with(|pending| *pending.borrow_mut() = Some(match_id.to_owned()));
+    wake();
+    Ok(())
+}
+
+pub fn start_network_match(config_json: &str) -> Result<(), JsValue> {
+    if !STARTED.with(Cell::get) {
+        return Err(JsValue::from_str("游戏尚未初始化"));
+    }
+    if config_json.len() > 65_536 {
+        return Err(JsValue::from_str("网络对局配置过大"));
+    }
+    let config = serde_json::from_str(config_json)
+        .map_err(|error| JsValue::from_str(&format!("网络对局配置无效：{error}")))?;
+    NETWORK_START.with(|pending| {
+        if pending.borrow().is_some() {
+            return Err(JsValue::from_str("网络对局正在启动"));
+        }
+        *pending.borrow_mut() = Some(config);
+        Ok(())
+    })?;
+    wake();
+    Ok(())
+}
+
+fn notify(name: &str) {
+    if let (Some(window), Ok(event)) = (web_sys::window(), web_sys::Event::new(name)) {
+        let _ = window.dispatch_event(&event);
+    }
+}
+
+pub(super) fn request_network_lobby() {
+    notify("vera-native-network");
+}
+
+pub(super) fn notify_network_return() {
+    notify("vera-native-network-return");
+}
+
+struct PendingInitialization {
+    window: Arc<Window>,
+    result: Rc<RefCell<Option<anyhow::Result<Box<AppState>>>>>,
+    live: Rc<Cell<bool>>,
+}
+
+pub(super) struct BrowserState {
+    canvas: HtmlCanvasElement,
+    pending: Option<PendingInitialization>,
+    attempted: bool,
+    last_diagnostics: Option<Instant>,
+    last_document_hidden: Option<bool>,
+}
+
+/// Start once, after the retail provider has mounted and hydrated its files.
+/// winit retains App and returns control to the browser immediately.
+pub fn start(canvas: HtmlCanvasElement) -> Result<(), JsValue> {
+    if STARTED.with(Cell::get) {
+        return Err(JsValue::from_str(
+            "The native browser event loop is already running",
+        ));
+    }
+    let event_loop = EventLoop::new().map_err(|error| JsValue::from_str(&error.to_string()))?;
+    canvas.set_attribute("tabindex", "0")?;
+    canvas.set_attribute("data-vera-stage", "starting")?;
+    let mut app = App::default();
+    app.browser = Some(BrowserState {
+        canvas,
+        pending: None,
+        attempted: false,
+        last_diagnostics: None,
+        last_document_hidden: None,
+    });
+    BROWSER_PROXY.with(|proxy| *proxy.borrow_mut() = Some(event_loop.create_proxy()));
+    STARTED.with(|started| started.set(true));
+    event_loop.spawn_app(app);
+    Ok(())
+}
+
+/// Explicitly enable a low-frequency, read-only acceptance snapshot. No hashes,
+/// commands, or writable simulation references are exposed to JavaScript.
+pub fn diagnostics() -> JsValue {
+    DIAGNOSTICS_ENABLED.with(|enabled| enabled.set(true));
+    DIAGNOSTICS
+        .with(|value| js_sys::JSON::parse(&value.borrow().to_string()).unwrap_or(JsValue::NULL))
+}
+
+fn set_stage(browser: &BrowserState, stage: &str, error: Option<&str>) {
+    let _ = browser.canvas.set_attribute("data-vera-stage", stage);
+    if let Some(error) = error {
+        let _ = browser.canvas.set_attribute("data-vera-error", error);
+    }
+    DIAGNOSTICS.with(|value| *value.borrow_mut() = json!({"stage":stage,"error":error}));
+}
+
+impl App {
+    pub(super) fn poll_browser_network(&mut self) {
+        let Some(state) = self.state.as_mut() else {
+            return;
+        };
+        if let Some(match_id) = NETWORK_LEAVE.with(|pending| pending.borrow_mut().take()) {
+            let canceled = NETWORK_START.with(|pending| {
+                let mut pending = pending.borrow_mut();
+                if pending
+                    .as_ref()
+                    .is_some_and(|config| config.match_id == match_id)
+                {
+                    *pending = None;
+                    true
+                } else {
+                    false
+                }
+            });
+            let current = crate::app::browser_network::status()["matchId"].as_str()
+                == Some(match_id.as_str());
+            if current && state.match_state.browser_network.is_some() {
+                crate::app::loading::pump::clear_loading_state(state);
+                Self::return_to_main_menu(state);
+            } else if canceled {
+                notify_network_return();
+            }
+        }
+        if let Some(config) = NETWORK_START.with(|pending| pending.borrow_mut().take()) {
+            match network_launch::start(state, config) {
+                Ok(()) => notify("vera-native-network-started"),
+                Err(error) => {
+                    let message = format!("网络对局启动失败：{error:#}");
+                    log::error!("{message}");
+                    if let Some(browser) = self.browser.as_ref() {
+                        let _ = browser
+                            .canvas
+                            .set_attribute("data-vera-network-error", &message);
+                    }
+                    notify("vera-native-network-error");
+                }
+            }
+        }
+        crate::app::browser_network::poll(state);
+        if let Some(browser) = self.browser.as_mut()
+            && let Some(document) = web_sys::window().and_then(|window| window.document())
+        {
+            let hidden = document.hidden();
+            if browser.last_document_hidden != Some(hidden) {
+                browser.last_document_hidden = Some(hidden);
+                Self::set_window_hidden(state, hidden);
+            }
+        }
+        notify("vera-native-network-service");
+    }
+    pub(super) fn begin_browser_initialization(&mut self, event_loop: &ActiveEventLoop) {
+        if self.state.is_some() {
+            return;
+        }
+        let Some(browser) = self.browser.as_mut() else {
+            log::error!("Browser App must be started with app::browser::start(canvas)");
+            event_loop.exit();
+            return;
+        };
+        if browser.attempted {
+            return;
+        }
+        browser.attempted = true;
+        set_stage(browser, "gpu", None);
+        let prepared = match Self::prepare_initialization(
+            event_loop,
+            None,
+            self.startup_options,
+            false,
+            browser.canvas.clone(),
+        ) {
+            Ok(prepared) => prepared,
+            Err(error) => {
+                let text = format!("Native browser window initialization failed: {error:#}");
+                log::error!("{text}");
+                set_stage(browser, "error", Some(&text));
+                self.startup_failure = Some(text);
+                event_loop.exit();
+                return;
+            }
+        };
+        let window = prepared.window.clone();
+        let result = Rc::new(RefCell::new(None));
+        let live = Rc::new(Cell::new(true));
+        browser.pending = Some(PendingInitialization {
+            window: window.clone(),
+            result: result.clone(),
+            live: live.clone(),
+        });
+        wasm_bindgen_futures::spawn_local(async move {
+            let initialized = match GpuContext::new_async(window.clone()).await {
+                Ok(gpu) if live.get() => App::finish_initialization(prepared, gpu),
+                Ok(_) => return,
+                Err(error) => Err(error),
+            };
+            if live.get() {
+                *result.borrow_mut() = Some(initialized);
+                window.request_redraw();
+            }
+        });
+    }
+
+    pub(super) fn poll_browser_initialization(&mut self, event_loop: &ActiveEventLoop) -> bool {
+        if self.state.is_some() {
+            return true;
+        }
+        let Some(browser) = self.browser.as_mut() else {
+            return false;
+        };
+        let result = browser
+            .pending
+            .as_ref()
+            .and_then(|pending| pending.result.borrow_mut().take());
+        let Some(result) = result else {
+            return false;
+        };
+        let pending = browser.pending.take();
+        match result {
+            Ok(state) => {
+                super::input::cursor::apply_cursor_confinement(&state);
+                state.platform.window.request_redraw();
+                set_stage(browser, "ready", None);
+                self.state = Some(state);
+                log::info!("Native browser initialization complete");
+                true
+            }
+            Err(error) => {
+                if let Some(pending) = pending {
+                    pending.window.set_cursor_visible(true);
+                }
+                let text = format!("Native browser initialization failed: {error:#}");
+                log::error!("{text}");
+                set_stage(browser, "error", Some(&text));
+                self.startup_failure = Some(text);
+                event_loop.exit();
+                false
+            }
+        }
+    }
+
+    pub(super) fn admit_browser_event(
+        &mut self,
+        event_loop: &ActiveEventLoop,
+        event: &WindowEvent,
+    ) -> bool {
+        if matches!(event, WindowEvent::CloseRequested) && self.state.is_none() {
+            self.cancel_browser_initialization();
+            event_loop.exit();
+            return false;
+        }
+        if !self.poll_browser_initialization(event_loop) {
+            return false;
+        }
+        let trusted_input = matches!(
+            event,
+            WindowEvent::MouseInput {
+                state: ElementState::Pressed,
+                ..
+            } | WindowEvent::KeyboardInput {
+                event: winit::event::KeyEvent {
+                    state: ElementState::Pressed,
+                    ..
+                },
+                ..
+            } | WindowEvent::Touch(winit::event::Touch {
+                phase: TouchPhase::Started,
+                ..
+            })
+        );
+        if trusted_input {
+            if let Err(error) = crate::audio::browser_output::unlock() {
+                log::warn!("Browser audio activation was refused: {error:?}");
+            }
+        }
+        true
+    }
+
+    pub(super) fn cancel_browser_initialization(&mut self) {
+        if let Some(state) = self.state.as_ref() {
+            state.platform.window.set_cursor_visible(true);
+        }
+        if let Some(browser) = self.browser.as_mut() {
+            if let Some(pending) = browser.pending.take() {
+                pending.live.set(false);
+                pending.window.set_cursor_visible(true);
+            }
+            if self.startup_failure.is_none() {
+                set_stage(browser, "closed", None);
+            }
+        }
+    }
+
+    pub(super) fn update_browser_diagnostics(&mut self) {
+        if !DIAGNOSTICS_ENABLED.with(Cell::get) {
+            return;
+        }
+        let Some(browser) = self.browser.as_mut() else {
+            return;
+        };
+        let now = Instant::now();
+        if browser
+            .last_diagnostics
+            .is_some_and(|last| now.duration_since(last).as_millis() < 250)
+        {
+            return;
+        }
+        browser.last_diagnostics = Some(now);
+        let Some(state) = self.state.as_ref() else {
+            return;
+        };
+        let snapshot = diagnostic_snapshot(state);
+        DIAGNOSTICS.with(|value| *value.borrow_mut() = snapshot);
+    }
+}
+
+fn diagnostic_snapshot(state: &AppState) -> Value {
+    let game_speed = state.match_state.sim_runtime.as_ref().map_or_else(
+        || {
+            state
+                .match_state
+                .match_presentation
+                .in_game_options
+                .game_speed
+                .min(6) as u8
+        },
+        |runtime| {
+            runtime
+                .simulation
+                .session()
+                .game_options()
+                .game_speed
+                .clamp(0, 6) as u8
+        },
+    );
+    let interpolation = state.match_state.match_presentation.interpolation.readout();
+    let mode = match state.frontend.screen {
+        GameScreen::MainMenu => "menu",
+        GameScreen::Loading => "loading",
+        GameScreen::InGame => "ingame",
+        GameScreen::MissionResult { .. } => "result",
+    };
+    let input = &state.match_state.input;
+    let viewport = super::input::camera::tactical_viewport_px(state);
+    let pool = &state.renderer.instance_pool;
+    let instances = |key| pool.get(key).map_or(0, |(_, count)| count);
+    let center_base_binding = input
+        .hotkey_bindings
+        .first_key(super::input::hotkeys::HotkeyCommand::CenterBase);
+    let mut result = json!({
+        "stage":"ready","mode":mode,
+        "shellRoute":format!("{:?}",state.frontend.shell_route),
+        "menuError":state.frontend.main_menu_shell_error,
+        "width":state.render_width(),"height":state.render_height(),
+        "windowWidth":state.renderer.gpu.config.width,"windowHeight":state.renderer.gpu.config.height,
+        "selected":state.match_state.input.selection_order,
+        "gameSpeed":game_speed,
+        "speedBucketMs":state.platform.frame_pacer.budget_ms(game_speed),
+        "renderInterpolation":interpolation.interpolation,
+        "interpolationSampling":interpolation.sampling,
+        "observedTps":interpolation.tps,
+        "renderFrameAttemptMsMean":state.diag.frame_timer.frame_ms_mean(),
+        "camera":{"x":input.camera_x,"y":input.camera_y,"zoom":input.zoom_level},
+        "cursor":{"x":input.cursor_x,"y":input.cursor_y},
+        "pointerInClient":state.platform.pointer_in_client,
+        "windowActive":state.platform.window_active,
+        "windowHidden":state.platform.window_hidden,
+        "tacticalViewport":{"x":viewport.0,"y":viewport.1,"width":viewport.2,"height":viewport.3},
+        "centerBaseBinding":center_base_binding,
+        "hBinding":format!("{:?}",input.hotkey_bindings.command_at(72)),
+        "terrain":state.match_state.match_presentation.terrain_grid.as_ref().map(|grid|json!({
+            "cells":grid.cells.len(),"originX":grid.origin_x,"originY":grid.origin_y,
+            "worldWidth":grid.world_width,"worldHeight":grid.world_height,
+        })),
+        "renderInstances":{"terrain":instances("terrain"),"cellBodies":instances("cell_body"),
+            "smudges":instances("smudge"),"bridgeBodyShadows":instances("overlay_bridge_body_shadow"),
+            "cellSparkles":instances("cell_sparkles"),"buildingStatusText":instances("building_status_text")},
+        "randomMap":state.frontend.skirmish_shell_state.random_map_setup_modal.as_ref().map(|modal| json!({
+            "generating":modal.generating,"generated":modal.generated,
+            "seed":modal.options.seed,"width":modal.options.width,"height":modal.options.height,
+            "previewGeneration":modal.preview_generation,
+        })),
+    });
+    let Some(runtime) = state.match_state.sim_runtime.as_ref() else {
+        return result;
+    };
+    let sim = &runtime.simulation;
+    let rules = &runtime.resources.rules;
+    let owner_name = super::input::commands::preferred_local_owner_name(state);
+    let owner = owner_name
+        .as_deref()
+        .and_then(|name| sim.interner().get(name));
+    result["tick"] = json!(sim.session().tick());
+    result["localOwner"] = json!(owner.map(|id| id.index()));
+    result["localOwnerName"] = json!(owner_name);
+    result["screenEntityCount"] =
+        json!(super::presentation::instances::tactical_screen_entity_encounter_order(state).len());
+    result["localVision"] = json!(owner.and_then(|owner|sim.fog().by_owner().get(&owner)).map(|vision| {
+        let mut revealed = 0usize;
+        let mut visible = 0usize;
+        for ry in 0..vision.height() {
+            for rx in 0..vision.width() {
+                revealed += usize::from(vision.is_revealed(rx,ry));
+                visible += usize::from(vision.is_visible(rx,ry));
+            }
+        }
+        json!({"width":vision.width(),"height":vision.height(),"revealedCells":revealed,"visibleCells":visible})
+    }));
+    result["players"] = json!(sim.houses().iter().map(|(id,house)| {
+        let name = sim.resolve(*id);
+        let (power,drain) = crate::sim::production::power_balance_for_owner(sim,rules,name);
+        json!({"owner":id.index(),"name":name,"credits":crate::sim::production::credits_for_owner(sim,name),"power":power,"drain":drain,"defeated":house.is_defeated()})
+    }).collect::<Vec<_>>());
+    result["units"] = json!(sim.entities().values_sorted().filter(|entity| Some(entity.owner())==owner).map(|entity| {
+        let position = entity.position;
+        json!({"id":entity.stable_id(),"type":sim.resolve(entity.type_ref()),"rx":position.rx(),"ry":position.ry(),"hp":entity.health.current(),"limbo":entity.in_limbo(),"alive":entity.is_alive()})
+    }).collect::<Vec<_>>());
+    if let (Some(owner_name), Some(owner)) = (owner_name.as_deref(), owner) {
+        result["queues"] = json!(crate::sim::production::queue_view_for_owner(sim,rules,owner_name).into_iter().map(|queue| {
+            let progress = if queue.state == crate::sim::production::BuildQueueState::Queued {
+                0
+            } else {
+                sim.production().factories().view(owner,queue.queue_category).map_or(0,|factory|factory.progress)
+            };
+            json!({"type":sim.resolve(queue.type_id),"category":format!("{:?}",queue.queue_category),"state":format!("{:?}",queue.state),"progress":progress,"total":crate::sim::production::PRODUCTION_STEPS})
+        }).collect::<Vec<_>>());
+        result["ready"] = json!(
+            crate::sim::production::ready_buildings_for_owner(sim, rules, owner_name)
+                .into_iter()
+                .map(|item| sim.resolve(item.type_id))
+                .collect::<Vec<_>>()
+        );
+    }
+    result
+}
diff --git a/src/app/browser/network_launch.rs b/src/app/browser/network_launch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d60618c4c05ed411c5460c9370117c9d2973dd9c
--- /dev/null
+++ b/src/app/browser/network_launch.rs
@@ -0,0 +1,215 @@
+//! Validated room handoff into the existing native network loading owner.
+
+use crate::app::{AppState, GameScreen};
+use crate::skirmish_launch::{
+    AiDifficulty, LaunchCountry, LaunchHumanRole, LaunchStartPosition, LaunchTeam,
+    PreFillHouseRoster, SkirmishAiSlot, SkirmishHumanSlot, SkirmishLaunchMode,
+    SkirmishLaunchOptions, SkirmishLaunchSession, SkirmishLocalSlot,
+};
+use serde::Deserialize;
+use std::collections::BTreeSet;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct NetworkStartConfig {
+    pub(super) match_id: String,
+    seed: u32,
+    map: String,
+    local_player: usize,
+    players: Vec<Player>,
+    options: Options,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Player {
+    slot: u8,
+    name: String,
+    country: LaunchCountry,
+    color: u8,
+    start: i32,
+    team: i32,
+    human: bool,
+    difficulty: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Options {
+    credits: i32,
+    unit_count: i32,
+    game_speed: i32,
+    short_game: bool,
+    super_weapons: bool,
+    crates: bool,
+    mcv_repacks: bool,
+    build_off_ally: bool,
+    destroyable_bridges: bool,
+}
+
+pub(super) fn start(state: &mut AppState, config: NetworkStartConfig) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        state.frontend.screen == GameScreen::MainMenu,
+        "请先退出当前对局"
+    );
+    anyhow::ensure!(
+        !crate::app::browser_network::active(state),
+        "已有网络对局尚未退出"
+    );
+    anyhow::ensure!(
+        !config.match_id.is_empty() && config.match_id.len() <= 128,
+        "对局标识无效"
+    );
+    anyhow::ensure!(
+        (2..=8).contains(&config.players.len()),
+        "网络对局需要 2 至 8 个玩家"
+    );
+    anyhow::ensure!(
+        config
+            .players
+            .windows(2)
+            .all(|pair| pair[0].slot < pair[1].slot),
+        "玩家顺序必须按房间位置固定"
+    );
+    let map = state
+        .frontend
+        .scenario_catalog
+        .shell_maps()
+        .iter()
+        .find(|map| map.file_name.eq_ignore_ascii_case(&config.map))
+        .ok_or_else(|| anyhow::anyhow!("本地没有房间选择的地图"))?;
+    anyhow::ensure!(
+        map.player_capacity >= config.players.len() as i32,
+        "地图不能容纳所有玩家"
+    );
+    let selected_map_file = map.file_name.clone();
+    let mode = state
+        .frontend
+        .skirmish_modes
+        .iter()
+        .find(|mode| mode.class == crate::skirmish_modes::MpModeClass::Battle)
+        .ok_or_else(|| anyhow::anyhow!("原生对战模式不可用"))?;
+    let mode = SkirmishLaunchMode::from_game_mode(mode);
+    let mut humans = Vec::new();
+    let mut opponents = Vec::new();
+    let (mut names, mut colors, mut starts) = (BTreeSet::new(), BTreeSet::new(), BTreeSet::new());
+    for player in config.players {
+        anyhow::ensure!(
+            player.slot < 8
+                && player.color < 8
+                && (0..8).contains(&player.start)
+                && (-1..4).contains(&player.team),
+            "玩家位置、颜色或队伍无效"
+        );
+        anyhow::ensure!(
+            !player.name.trim().is_empty() && player.name.len() <= 128,
+            "玩家名称无效"
+        );
+        anyhow::ensure!(
+            names.insert(player.name.to_lowercase())
+                && colors.insert(player.color)
+                && starts.insert(player.start),
+            "玩家名称、颜色与出生位置必须各不相同"
+        );
+        anyhow::ensure!(
+            map.multiplayer_start_waypoints
+                .iter()
+                .any(|waypoint| waypoint.index == player.start as u32),
+            "地图没有指定的出生位置"
+        );
+        let slot = SkirmishLocalSlot {
+            country: player.country,
+            country_random: false,
+            color_index: player.color,
+            color_random: false,
+            start_position: LaunchStartPosition::Position(player.start as u8),
+            team: LaunchTeam::from_shell_value(player.team),
+        };
+        if player.human {
+            humans.push(SkirmishHumanSlot {
+                raw_slot_index: Some(player.slot),
+                name: player.name,
+                slot,
+                role: LaunchHumanRole::default(),
+            });
+        } else {
+            let difficulty = match player.difficulty.as_str() {
+                "easy" => AiDifficulty::Easy,
+                "normal" => AiDifficulty::Normal,
+                "hard" => AiDifficulty::Hard,
+                _ => anyhow::bail!("电脑难度无效"),
+            };
+            opponents.push(SkirmishAiSlot {
+                raw_slot_index: player.slot,
+                country: slot.country,
+                country_random: false,
+                color_index: slot.color_index,
+                color_random: false,
+                start_position: slot.start_position,
+                team: slot.team,
+                difficulty,
+            });
+        }
+    }
+    anyhow::ensure!(
+        humans.len() >= 2 && config.local_player < humans.len(),
+        "本地玩家不属于该房间"
+    );
+    anyhow::ensure!(
+        (0..=1_000_000).contains(&config.options.credits)
+            && (0..=100).contains(&config.options.unit_count)
+            && (0..=6).contains(&config.options.game_speed),
+        "对局选项超出范围"
+    );
+    let mut options = SkirmishLaunchOptions::default();
+    options.starting_credits = config.options.credits;
+    options.unit_count = config.options.unit_count;
+    options.game_speed = config.options.game_speed;
+    options.short_game = config.options.short_game;
+    options.super_weapons = config.options.super_weapons;
+    options.crates = config.options.crates;
+    options.mcv_redeploy = config.options.mcv_repacks;
+    options.build_off_ally = config.options.build_off_ally;
+    options.bridges_destroyable = config.options.destroyable_bridges;
+    let mut launch = SkirmishLaunchSession {
+        mode,
+        selected_map_file: Some(selected_map_file),
+        humans,
+        local_player_index: config.local_player,
+        ai_player_count: opponents.len() as i32,
+        pre_fill_house_roster: PreFillHouseRoster::from_compact_skirmish(opponents.len()),
+        opponents,
+        options,
+    };
+    launch.rebuild_house_roster();
+    state
+        .frontend
+        .multiplayer_shell_runtime
+        .validate_network_countries(&launch)?;
+    crate::sim::scenario_bootstrap::MatchLaunchDescriptor::from_resolved(launch.clone())
+        .map_err(|error| anyhow::anyhow!("房间出生设置未完成：{error}"))?;
+    state
+        .match_state
+        .session
+        .enter_network(crate::app::match_runtime::session::NetworkReturnContext::LanLobby);
+    state
+        .match_state
+        .session
+        .accept_network_setup(launch, config.local_player == 0, None)?;
+    // The web service has its own all-player turn barrier. Retain native's
+    // required timing receipt; no fake LAN peer packets or local seed draws.
+    state.match_state.session.prepare_network_timing(2, || 0)?;
+    let startup = state
+        .match_state
+        .session
+        .freeze_network_start(config.seed)?;
+    crate::app::browser_network::begin(state, config.match_id, config.local_player)?;
+    state.frontend.shell_route = crate::app::shell_route::ShellRoute::MainMenu;
+    crate::app::frontend::main_menu_shell_render::clear_ra2ts_movie_session(state);
+    crate::app::loading::pump::begin_loading(
+        state,
+        crate::app::loading::pump::LoadingRequest::network(startup),
+    );
+    state.platform.window.request_redraw();
+    Ok(())
+}
diff --git a/src/app/browser_network.rs b/src/app/browser_network.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3419789d4d04f57fa4e51f7216296c8b00f1faa7
--- /dev/null
+++ b/src/app/browser_network.rs
@@ -0,0 +1,693 @@
+//! Browser transport for the native command stream. This module owns only
+//! admission, ordered turns and readiness; SimRuntime remains the sole world.
+//! Select is a process-local input snapshot and never crosses the network.
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+
+use anyhow::{Result, bail, ensure};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use super::AppState;
+use crate::net::browser_command_admission::{Admission, validate_command};
+use crate::sim::command::{Command, CommandEnvelope};
+use crate::sim::intern::InternedId;
+
+const MAX_COMMANDS: usize = 1024;
+const SOURCE_REVISION: &str = match option_env!("VERA_WEB_SOURCE_REVISION") {
+    Some(value) => value,
+    None => "unrecorded",
+};
+const PATCH_HASH: &str = match option_env!("VERA_WEB_BROWSER_PATCH_HASH") {
+    Some(value) => value,
+    None => "unrecorded",
+};
+const RESOURCE_MANIFEST: &str = match option_env!("VERA_WEB_ASSET_MANIFEST_SHA256") {
+    Some(value) => value,
+    None => "",
+};
+
+thread_local! {
+    static INCOMING: RefCell<VecDeque<Incoming>> = const { RefCell::new(VecDeque::new()) };
+    static OUTGOING: RefCell<VecDeque<Value>> = const { RefCell::new(VecDeque::new()) };
+    static STATUS: RefCell<Value> = RefCell::new(json!({"phase":"idle"}));
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Loading,
+    Loaded,
+    Running,
+    Finishing,
+    Finished,
+    Stopped,
+}
+
+impl Phase {
+    fn text(self) -> &'static str {
+        match self {
+            Self::Loading => "loading",
+            Self::Loaded => "loaded",
+            Self::Running => "running",
+            Self::Finishing => "finishing",
+            Self::Finished => "finished",
+            Self::Stopped => "stopped",
+        }
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct WireCommand {
+    player: usize,
+    envelope: CommandEnvelope,
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase", deny_unknown_fields)]
+enum Incoming {
+    Progress {
+        source: usize,
+        percent: i32,
+    },
+    Ready {
+        tick: u64,
+        bootstrap: String,
+    },
+    Turn {
+        tick: u64,
+        commands: Vec<WireCommand>,
+    },
+    Chat {
+        source: usize,
+        text: String,
+    },
+    Taunt {
+        source: usize,
+        byte: u8,
+    },
+    Finished {
+        tick: u64,
+        checksum: String,
+    },
+    Stopped {
+        reason: String,
+    },
+}
+
+pub(crate) struct Session {
+    match_id: String,
+    local_player: usize,
+    phase: Phase,
+    owners: Vec<InternedId>,
+    next_tick: u64,
+    pending: Vec<CommandEnvelope>,
+    submitted: bool,
+    accepted: Option<Vec<CommandEnvelope>>,
+    committing: bool,
+    committing_frame: Option<u32>,
+    finished_tick: Option<u64>,
+    in_flight_turn: Option<u64>,
+    error: Option<String>,
+    last_hash: String,
+    full_state_hash: String,
+    full_state_tick: Option<u64>,
+}
+
+fn emit(value: Value) {
+    OUTGOING.with(|outgoing| outgoing.borrow_mut().push_back(value));
+}
+
+fn publish(session: &Session) {
+    STATUS.with(|status| *status.borrow_mut() = json!({
+        "phase":session.phase.text(), "matchId":session.match_id,
+        "localPlayer":session.local_player, "nextTick":session.next_tick,
+        "submitted":session.submitted, "turnReady":session.accepted.is_some(), "finishedTick":session.finished_tick,
+        "hash":session.last_hash, "hashAlgorithm":if session.last_hash.starts_with("retail:") { "retail-multiplayer-v1" } else if session.last_hash.starts_with("launch:") { "launch-receipt-v1" } else { "diagnostic-full-state-v1" },
+        "diagnosticFullStateHash":session.full_state_hash,"diagnosticFullStateTick":session.full_state_tick, "owners":session.owners.iter().map(|id| id.index()).collect::<Vec<_>>(),
+        "error":session.error,
+        "sourceRevision":SOURCE_REVISION,"patchHash":PATCH_HASH,"resourceManifest":RESOURCE_MANIFEST,
+    }));
+}
+
+/// Called only by the native accepted-network-start owner, after freezing the
+/// shared roster/seed/map. JavaScript cannot create an arbitrary live world.
+pub(crate) fn begin(state: &mut AppState, match_id: String, local_player: usize) -> Result<()> {
+    ensure!(
+        !match_id.is_empty() && match_id.len() <= 128,
+        "invalid network match identity"
+    );
+    ensure!(
+        state
+            .match_state
+            .browser_network
+            .as_ref()
+            .is_none_or(|s| s.phase == Phase::Stopped),
+        "a browser network match is already active"
+    );
+    let launch = state
+        .match_state
+        .session
+        .network_setup()
+        .ok_or_else(|| anyhow::anyhow!("native network setup is missing"))?;
+    ensure!(
+        launch.humans.len() >= 2 && launch.humans.len() <= 8,
+        "network match requires 2 to 8 humans"
+    );
+    ensure!(
+        local_player == launch.local_player_index && local_player < launch.humans.len(),
+        "local player differs from native accepted setup"
+    );
+    INCOMING.with(|incoming| incoming.borrow_mut().clear());
+    OUTGOING.with(|outgoing| outgoing.borrow_mut().clear());
+    let session = Session {
+        match_id,
+        local_player,
+        phase: Phase::Loading,
+        owners: Vec::new(),
+        next_tick: 0,
+        pending: Vec::new(),
+        submitted: false,
+        accepted: None,
+        committing: false,
+        committing_frame: None,
+        finished_tick: None,
+        in_flight_turn: None,
+        error: None,
+        last_hash: String::new(),
+        full_state_hash: String::new(),
+        full_state_tick: None,
+    };
+    publish(&session);
+    state.match_state.browser_network = Some(session);
+    state.platform.browser_online = true;
+    Ok(())
+}
+
+fn fail(session: &mut Session, reason: String, notify: bool) {
+    if session.phase == Phase::Stopped {
+        return;
+    }
+    session.phase = Phase::Stopped;
+    session.pending.clear();
+    session.accepted = None;
+    session.committing = false;
+    session.committing_frame = None;
+    session.error = Some(reason.clone());
+    OUTGOING.with(|outgoing| outgoing.borrow_mut().clear());
+    if notify {
+        emit(json!({"type":"leave", "matchId":session.match_id,"reason":reason}));
+    }
+    log::error!("Native network match stopped: {reason}");
+}
+
+pub(crate) fn stop(state: &mut AppState, reason: &str) {
+    if let Some(session) = state.match_state.browser_network.as_mut() {
+        if matches!(session.phase, Phase::Finishing | Phase::Finished) {
+            // Continue uses the existing leave route after the native result
+            // page. A completed result is not a network error.
+            session.phase = Phase::Stopped;
+            session.error = None;
+            session.pending.clear();
+            session.accepted = None;
+            emit(json!({"type":"leave", "matchId":session.match_id,"reason":reason}));
+        } else {
+            fail(session, reason.to_owned(), true);
+        }
+        publish(session);
+    }
+    INCOMING.with(|incoming| incoming.borrow_mut().clear());
+    state.platform.browser_online = false;
+}
+
+pub fn status() -> Value {
+    STATUS.with(|status| status.borrow().clone())
+}
+pub fn drain_outbox() -> Value {
+    OUTGOING.with(|outgoing| Value::Array(outgoing.borrow_mut().drain(..).collect()))
+}
+
+/// Only a message for the active admitted match can enter the mailbox. Native
+/// state validation occurs in poll on the app's ordinary execution thread.
+pub fn receive(match_id: &str, message: &str) -> Result<()> {
+    ensure!(
+        message.len() <= 1024 * 1024,
+        "network message exceeds one MiB"
+    );
+    let allowed = STATUS.with(|status| {
+        let status = status.borrow();
+        status["matchId"].as_str() == Some(match_id) && status["phase"].as_str() != Some("stopped")
+    });
+    ensure!(allowed, "message does not belong to an active native match");
+    let message: Incoming = serde_json::from_str(message)?;
+    if let Incoming::Turn { commands, .. } = &message {
+        ensure!(
+            commands.len() <= MAX_COMMANDS,
+            "too many native commands in one turn"
+        );
+    }
+    INCOMING.with(|incoming| {
+        let mut incoming = incoming.borrow_mut();
+        ensure!(incoming.len() < 256, "network inbox overflow");
+        incoming.push_back(message);
+        Ok(())
+    })?;
+    crate::app::browser::wake();
+    Ok(())
+}
+
+/// Shared gameplay input leaves through this owner. The command has already
+/// passed native click resolution/record round-trips, never TS action mapping.
+pub(crate) fn enqueue(state: &mut AppState, mut commands: Vec<CommandEnvelope>) -> bool {
+    let Some(session) = state.match_state.browser_network.as_mut() else {
+        return false;
+    };
+    if matches!(
+        session.phase,
+        Phase::Finishing | Phase::Finished | Phase::Stopped
+    ) {
+        return false;
+    }
+    let Some(runtime) = state.match_state.sim_runtime.as_ref() else {
+        return false;
+    };
+    let Some(owner) = runtime.simulation.session().current_house() else {
+        return false;
+    };
+    if commands
+        .iter()
+        .any(|command| command.owner != owner || matches!(command.payload, Command::Select { .. }))
+    {
+        fail(
+            session,
+            "local native command has an invalid owner or selection payload".into(),
+            true,
+        );
+        publish(session);
+        return false;
+    }
+    if session.pending.len() + commands.len() > 256 {
+        fail(
+            session,
+            "native input queue exceeds 256 commands per turn".into(),
+            true,
+        );
+        publish(session);
+        return false;
+    }
+    // Wire execution stamps are assigned when the complete next input is sent.
+    session.pending.append(&mut commands);
+    true
+}
+
+/// Reuse the native local House's accepted SavourDelay/voice-wait edge.
+/// This observes presentation termination; it never manufactures an outcome.
+fn native_outcome_ready(state: &AppState) -> bool {
+    state.match_state.scenario_outcome.is_some()
+        || state
+            .match_state
+            .sim_runtime
+            .as_ref()
+            .is_some_and(|runtime| {
+                state
+                    .match_state
+                    .local_player_owner()
+                    .and_then(|name| runtime.simulation.interner().get(name))
+                    .and_then(|owner| runtime.simulation.ready_outcome_for_owner(owner))
+                    .is_some()
+            })
+}
+
+fn begin_finishing_if_ready(state: &AppState, session: &mut Session) -> Result<()> {
+    if session.phase != Phase::Running || session.committing || !native_outcome_ready(state) {
+        return Ok(());
+    }
+    let tick = state
+        .match_state
+        .sim_runtime
+        .as_ref()
+        .ok_or_else(|| anyhow::anyhow!("finished native world is missing"))?
+        .simulation
+        .session()
+        .tick();
+    ensure!(
+        tick.checked_add(1) == Some(session.next_tick),
+        "finished native tick is not the last committed turn"
+    );
+    ensure!(
+        session.last_hash.starts_with("retail:"),
+        "finished native world has no committed Queue_AI checksum"
+    );
+    session.finished_tick = Some(tick);
+    // A turn already broadcast before the server learns this terminal edge
+    // may still arrive. Authenticate and discard at most that one turn.
+    session.in_flight_turn =
+        (session.submitted && session.accepted.is_none()).then_some(session.next_tick);
+    session.phase = Phase::Finishing;
+    session.pending.clear();
+    session.accepted = None;
+    session.submitted = false;
+    emit(json!({"type":"finished", "matchId":session.match_id,
+        "tick":tick, "checksum":session.last_hash}));
+    Ok(())
+}
+
+fn poll_session(state: &mut AppState, session: &mut Session) -> Result<()> {
+    begin_finishing_if_ready(state, session)?;
+    use crate::app::match_runtime::session::NetworkLoadingRequest;
+    for request in state.match_state.session.take_network_loading_requests() {
+        match request {
+            NetworkLoadingRequest::ReportProgress(percent) => {
+                ensure!(
+                    (0..=100).contains(&percent),
+                    "network standard-map progress outside 0..100"
+                );
+                emit(json!({"type":"progress","matchId":session.match_id,"percent":percent}));
+            }
+            NetworkLoadingRequest::Disconnect { .. }
+            | NetworkLoadingRequest::ProposeKick { .. } => {
+                bail!("native peer disconnected while loading or waiting");
+            }
+            NetworkLoadingRequest::Chat { recipients, text } => {
+                if matches!(session.phase, Phase::Finishing | Phase::Finished) {
+                    continue;
+                }
+                ensure!(
+                    session.phase == Phase::Running,
+                    "chat requires a running native match"
+                );
+                emit(
+                    json!({"type":"chat","matchId":session.match_id,"recipients":recipients,"text":text}),
+                );
+            }
+            NetworkLoadingRequest::Taunt { recipients, byte } => {
+                if matches!(session.phase, Phase::Finishing | Phase::Finished) {
+                    continue;
+                }
+                ensure!(
+                    session.phase == Phase::Running,
+                    "taunt requires a running native match"
+                );
+                emit(
+                    json!({"type":"taunt","matchId":session.match_id,"recipients":recipients,"byte":byte}),
+                );
+            }
+        }
+    }
+    let incoming = INCOMING.with(|incoming| incoming.borrow_mut().drain(..).collect::<Vec<_>>());
+    for message in incoming {
+        match message {
+            Incoming::Progress { source, percent } => {
+                ensure!(
+                    (0..=100).contains(&percent),
+                    "invalid peer loading progress"
+                );
+                crate::app::loading::pump::accept_network_loading_progress(state, source, percent);
+            }
+            Incoming::Ready { tick, bootstrap } => {
+                ensure!(
+                    session.phase == Phase::Loaded && tick == session.next_tick,
+                    "unexpected native ready tick"
+                );
+                ensure!(
+                    bootstrap == session.match_id,
+                    "native launch receipt belongs to another match"
+                );
+                // This is the server's frozen launch receipt, not an initial
+                // shared-world digest. The first real Queue_AI checksum is
+                // compared immediately after the first committed world frame.
+                session.last_hash = format!("launch:{}", session.match_id);
+                session.phase = Phase::Running;
+            }
+            Incoming::Turn { tick, commands } => {
+                let retiring_in_flight =
+                    session.phase == Phase::Finishing && session.in_flight_turn == Some(tick);
+                ensure!(
+                    ((session.phase == Phase::Running && session.submitted) || retiring_in_flight)
+                        && session.accepted.is_none()
+                        && !session.committing
+                        && tick == session.next_tick,
+                    "duplicate, stale or future native turn"
+                );
+                let sim = &state
+                    .match_state
+                    .sim_runtime
+                    .as_ref()
+                    .ok_or_else(|| anyhow::anyhow!("native world is missing"))?
+                    .simulation;
+                ensure!(
+                    tick == sim.session().tick() + 1,
+                    "native turn is not the world's next tick"
+                );
+                let mut admitted = Vec::with_capacity(commands.len());
+                let mut previous_player = 0;
+                for wire in commands {
+                    let owner = *session
+                        .owners
+                        .get(wire.player)
+                        .ok_or_else(|| anyhow::anyhow!("invalid native source participant"))?;
+                    ensure!(
+                        wire.player >= previous_player,
+                        "native turn is not in participant order"
+                    );
+                    previous_player = wire.player;
+                    if validate_command(sim, owner, &wire.envelope, tick)? == Admission::Apply {
+                        admitted.push(wire.envelope);
+                    }
+                }
+                if retiring_in_flight {
+                    session.in_flight_turn = None;
+                } else {
+                    session.accepted = Some(admitted);
+                }
+            }
+            Incoming::Finished { tick, checksum } => {
+                ensure!(
+                    session.phase == Phase::Finishing
+                        && session.finished_tick == Some(tick)
+                        && checksum == session.last_hash,
+                    "native finished acknowledgement differs from the committed result"
+                );
+                session.phase = Phase::Finished;
+                session.in_flight_turn = None;
+                session.pending.clear();
+                session.accepted = None;
+                log::info!("Native network match finished at committed tick {tick}");
+            }
+            Incoming::Stopped { reason } => {
+                fail(session, reason, false);
+                return Ok(());
+            }
+            Incoming::Chat { source, text } => {
+                ensure!(
+                    matches!(session.phase, Phase::Running | Phase::Finishing)
+                        && source < session.owners.len()
+                        && text.len() <= 4096,
+                    "invalid native chat sender or text"
+                );
+                crate::app::match_runtime::network_match::service_event(
+                    state,
+                    crate::app::match_runtime::network_match::NetworkMatchEvent::Chat {
+                        source_index: source,
+                        text,
+                    },
+                )?;
+            }
+            Incoming::Taunt { source, byte } => {
+                ensure!(
+                    matches!(session.phase, Phase::Running | Phase::Finishing)
+                        && source < session.owners.len(),
+                    "invalid native taunt sender"
+                );
+                crate::app::match_runtime::network_match::service_event(
+                    state,
+                    crate::app::match_runtime::network_match::NetworkMatchEvent::Taunt { byte },
+                )?;
+            }
+        }
+    }
+    let Some(runtime) = state.match_state.sim_runtime.as_ref() else {
+        return Ok(());
+    };
+    let sim = &runtime.simulation;
+    if session.phase == Phase::Loading
+        && state.frontend.screen == crate::ui::game_screen::GameScreen::InGame
+    {
+        let count = state
+            .match_state
+            .session
+            .network_setup()
+            .ok_or_else(|| anyhow::anyhow!("native frozen launch disappeared"))?
+            .humans
+            .len();
+        session.owners = (0..count)
+            .map(|source| {
+                let name = state
+                    .match_state
+                    .session
+                    .network_source_owner(source)
+                    .ok_or_else(|| anyhow::anyhow!("native source has no House"))?;
+                sim.interner()
+                    .get(&name)
+                    .ok_or_else(|| anyhow::anyhow!("native source House is not interned"))
+            })
+            .collect::<Result<Vec<_>>>()?;
+        ensure!(
+            session.owners.get(session.local_player) == sim.session().current_house().as_ref(),
+            "native current House differs from admitted local participant"
+        );
+        session.next_tick = sim
+            .session()
+            .tick()
+            .checked_add(1)
+            .ok_or_else(|| anyhow::anyhow!("native tick overflow"))?;
+        session.full_state_hash = format!("{:016x}", sim.state_hash());
+        session.full_state_tick = Some(sim.session().tick());
+        session.last_hash = format!("full:{}", session.full_state_hash);
+        session.phase = Phase::Loaded;
+        emit(
+            json!({"type":"loaded", "matchId":session.match_id, "tick":sim.session().tick(),
+            "hash":session.full_state_hash,"owners":session.owners.iter().map(|id| id.index()).collect::<Vec<_>>(),
+            "build":format!("{SOURCE_REVISION}:{PATCH_HASH}"),"resourceManifest":RESOURCE_MANIFEST }),
+        );
+    }
+    if session.phase == Phase::Running
+        && !session.submitted
+        && session.accepted.is_none()
+        && !session.committing
+    {
+        ensure!(
+            sim.session().tick() + 1 == session.next_tick,
+            "native world advanced outside ordered turn"
+        );
+        // The preceding native Queue_AI already produced the sync checksum.
+        // Recomputing it would consume two extra Scenario RNG draws. Full state
+        // hashes include process-local presentation/defeat state, so they are
+        // retained only as diagnostics; the loaded barrier authenticates the
+        // frozen launch/build/assets rather than local presentation state.
+        let mut commands = std::mem::take(&mut session.pending);
+        for command in &mut commands {
+            command.execute_tick = session.next_tick;
+        }
+        emit(
+            json!({"type":"input","matchId":session.match_id,"tick":session.next_tick,
+            "prevHash":session.last_hash,"commands":commands}),
+        );
+        session.submitted = true;
+    }
+    Ok(())
+}
+
+/// Called on loading and gameplay passes. No async callback borrows AppState.
+pub(crate) fn poll(state: &mut AppState) {
+    let Some(mut session) = state.match_state.browser_network.take() else {
+        return;
+    };
+    if !matches!(session.phase, Phase::Stopped | Phase::Finished) {
+        if let Err(error) = poll_session(state, &mut session) {
+            fail(&mut session, error.to_string(), true);
+        }
+    }
+    publish(&session);
+    state.platform.browser_online = !matches!(session.phase, Phase::Stopped | Phase::Finished);
+    state.match_state.browser_network = Some(session);
+}
+
+pub(crate) fn allows_frame(state: &AppState) -> bool {
+    if !state.match_state.session_mode().is_network() {
+        return true;
+    }
+    state
+        .match_state
+        .browser_network
+        .as_ref()
+        .is_none_or(|session| {
+            session.phase == Phase::Running && session.accepted.is_some() && !session.committing
+        })
+}
+
+pub(crate) fn active(state: &AppState) -> bool {
+    state.match_state.session_mode().is_network()
+        && state
+            .match_state
+            .browser_network
+            .as_ref()
+            .is_some_and(|session| !matches!(session.phase, Phase::Stopped | Phase::Finished))
+}
+
+pub(crate) fn take_turn_commands(state: &mut AppState) -> Option<Vec<CommandEnvelope>> {
+    if !state.match_state.session_mode().is_network() {
+        return None;
+    }
+    let frame = state
+        .match_state
+        .sim_runtime
+        .as_ref()?
+        .simulation
+        .session()
+        .binary_frame();
+    let session = state.match_state.browser_network.as_mut()?;
+    if session.phase != Phase::Running {
+        return None;
+    }
+    let commands = session.accepted.take()?;
+    session.committing = true;
+    session.committing_frame = Some(frame);
+    Some(commands)
+}
+
+pub(crate) fn frame_finished(state: &mut AppState, committed: bool, checksum: Option<(u32, u32)>) {
+    let Some(mut session) = state.match_state.browser_network.take() else {
+        return;
+    };
+    if session.committing {
+        let tick = state
+            .match_state
+            .sim_runtime
+            .as_ref()
+            .map(|runtime| runtime.simulation.session().tick());
+        // Native Main_Tick computes Queue_AI's checksum, then returns on a
+        // ready local outcome before committing its frame counter. This is a
+        // successful terminal call, not a lost ordered turn. Keep the ordinal
+        // unchanged and consume that call's already-produced checksum so both
+        // peers acknowledge the same final native frame.
+        if !committed
+            && tick.and_then(|tick| tick.checked_add(1)) == Some(session.next_tick)
+            && native_outcome_ready(state)
+            && let Some((frame, value)) = checksum
+            && session.committing_frame == Some(frame)
+        {
+            session.last_hash = format!("retail:{frame}:{value:08x}");
+            session.submitted = false;
+            session.committing = false;
+            session.committing_frame = None;
+        } else if !committed || tick != Some(session.next_tick) {
+            fail(
+                &mut session,
+                "native ordered turn failed to commit exactly once".into(),
+                true,
+            );
+        } else if let Some((frame, value)) = checksum
+            && session.committing_frame == Some(frame)
+        {
+            session.last_hash = format!("retail:{frame}:{value:08x}");
+            session.next_tick += 1;
+            session.submitted = false;
+            session.committing = false;
+            session.committing_frame = None;
+        } else {
+            fail(
+                &mut session,
+                "native committed turn has no matching Queue_AI checksum".into(),
+                true,
+            );
+        }
+    }
+    if let Err(error) = begin_finishing_if_ready(state, &mut session) {
+        fail(&mut session, error.to_string(), true);
+    }
+    publish(&session);
+    state.platform.browser_online = !matches!(session.phase, Phase::Stopped | Phase::Finished);
+    state.match_state.browser_network = Some(session);
+}
