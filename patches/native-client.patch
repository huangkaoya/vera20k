diff --git a/Cargo.toml b/Cargo.toml
index 7fe21c7fb14b326b91df9ece1580fe148258dc8e..fbae801bf0e65f0ff15133db5fad5d5f7b62c2a2 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -54,6 +54,7 @@ telemetry-dashboard = ["vera20k-core/telemetry", "dep:getrandom", "dep:sha1"]
 debug-tools = ["telemetry-dashboard", "dev-overlays", "vera20k-core/debug-tools"]
 
 [dependencies]
+web-time = { workspace = true }
 # The GPU-free engine. Its dev features follow this package's.
 vera20k-core = { path = "src" }
 
@@ -128,6 +129,7 @@ vera20k-core = { path = "src", features = ["test-support"] }
 
 # Dependencies both crates use, declared once so they cannot drift apart.
 [workspace.dependencies]
+web-time = "=1.1.0"
 # glam provides fast vector/matrix math for rendering (screen coords, camera).
 glam = "0.29"
 serde = { version = "1", features = ["derive"] }
@@ -208,3 +210,22 @@ incremental = true
 inherits = "release"
 lto = "fat"
 codegen-units = 1
+
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+wasm-bindgen = "=0.2.114"
+wasm-bindgen-futures = "=0.4.64"
+js-sys = "=0.3.91"
+web-sys = { version = "=0.3.91", features = ["Window", "Document", "Element", "HtmlElement", "HtmlCanvasElement", "CanvasRenderingContext2d", "TextMetrics", "ImageData", "Performance", "Storage", "console", "Event", "CustomEvent", "CustomEventInit", "EventTarget", "KeyboardEvent", "MouseEvent", "WheelEvent", "FontFace", "FontFaceSet", "HtmlAudioElement", "HtmlVideoElement", "HtmlMediaElement", "MediaError", "BlobPropertyBag", "AudioContext", "BaseAudioContext", "AudioContextState", "AudioBuffer", "AudioBufferSourceNode", "AudioDestinationNode", "Request", "RequestInit", "RequestMode", "Response", "Headers", "Url", "Blob", "Navigator"] }
+cpal = { version = "=0.17.3", features = ["wasm-bindgen"] }
+
+[profile.web]
+inherits = "release"
+opt-level = 2
+lto = false
+codegen-units = 16
+debug = 1
+strip = "none"
+panic = "abort"
diff --git a/art/branding/README.md b/art/branding/README.md
index e477172eae758c6e88662c6856d4b56e2588d43e..30eec881de6f0421b13599d47b553858af552b5b 100644
--- a/art/branding/README.md
+++ b/art/branding/README.md
@@ -66,6 +66,16 @@ the in-game UI; long lines wrap within their own columns. Their
 text floats over a translucent bottom scrim inside the full-height 4:3 picture.
 The loading label sits above that overlay; no separate footer shrinks the art.
 
+The browser delivery is separate: `werhd-menu.mp4` is the approved H.264 preview,
+4,110,830 bytes, SHA-256
+`4ddd2bf8634ad34e8d5257263f91aaedb54419303c3edad8571e059927df4ae9`.
+It retains the same 632×570, 431-frame, 15 fps, silent sequence and is an optional
+content download. The browser's media decoder supplies RGBA frames to the existing
+GPU texture. The full `.wmvframes` archive is never embedded into the WASM build.
+The default web package uses `werhd-menu-poster.wmvframes`, containing the exact
+first PNG from that archive, without fetching the optional animation. iOS/macOS
+continue to use the original frame archive above.
+
 Format: `VWMV0001`, six little-endian u32 values (width, height, FPS numerator,
 FPS denominator, frame count, key interval), then frame-count-plus-one u64
 offsets relative to the following PNG payload. Transparent delta pixels retain
