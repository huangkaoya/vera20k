{
  "name": "werhd-vera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:native-web": "node tools/setup-native-web.mjs",
    "build:native-web": "node tools/build-native-web.mjs",
    "package:toy": "node tools/package-native-toy.mjs",
    "resources:toy:build": "python3 tools/package-native-resource-shards.py build",
    "resources:toy:check": "python3 tools/package-native-resource-shards.py check",
    "resources:toy:test": "node --expose-gc tools/test-native-resource-shards.mjs",
    "resources:toy:publish": "node tools/publish-native-resource-shards.mjs",
    "start:native-web": "node tools/native-server.mjs",
    "native:check": "python3 tools/native-source.py check",
    "native:record": "python3 tools/native-source.py record",
    "native:sync": "python3 tools/native-source.py sync",
    "native:test-sync": "python3 tools/native-source-test.py",
    "dev": "node tools/dev-server.mjs",
    "dev:stack": "node tools/run-stack.mjs --dev",
    "start:stack": "node tools/run-stack.mjs",
    "serve:web": "node tools/service.mjs web",
    "serve:resources": "node tools/service.mjs resources",
    "serve:lobby": "node tools/service.mjs lobby",
    "serve:battle": "node tools/service.mjs battle",
    "typecheck": "tsc --noEmit",
    "build:wasm": "node tools/build-wasm.mjs",
    "build:assets": "node tools/build-assets.mjs",
    "check:assets": "node tools/check-assets.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:parity": "node tools/test-parity.mjs",
    "test:zone-fill": "node tools/test-zone-fill.mjs",
    "sync:upstream": "python3 tools/sync_upstream.py sync",
    "sync:check": "python3 tools/sync_upstream.py check",
    "sync:patches": "python3 tools/sync_upstream.py patches",
    "check:isolation": "python3 tools/sync_upstream.py isolation",
    "native:update": "python3 tools/native-update.py",
    "native:validate": "python3 tools/native-update.py validate",
    "native:test-update": "python3 tools/native-update-test.py"
  },
  "dependencies": {
    "vite": "7.3.3",
    "ws": "8.18.1"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  }
}
